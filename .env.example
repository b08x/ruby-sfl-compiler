# SFL Compiler Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql:///sfl_compiler_dev

# LLM Provider for Pass 2 (DSPy.rb)
# Options: openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3-5-sonnet-20241022, openrouter/<model>
DSPY_PROVIDER=openai/gpt-4o-mini

# API Keys (set the one matching your DSPY_PROVIDER)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# spaCy Model for Pass 1
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=info
