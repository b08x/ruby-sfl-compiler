# SFL Compiler Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql:///sfl_compiler_dev

# LLM Provider for Pass 2 (DSPy.rb)
# OpenRouter options (recommended - one key, many models):
#   openrouter/mistralai/mistral-7b-instruct (fast, cheap)
#   openrouter/mistralai/mixtral-8x7b-instruct (better quality)
#   openrouter/google/gemini-2.0-flash-exp (free tier available!)
#   openrouter/google/gemini-pro (good quality)
#   openrouter/meta-llama/llama-3.1-8b-instruct (fast)
# Native Gemini (if you have Google API key):
#   google/gemini-2.0-flash-exp (free tier)
#   google/gemini-pro
# OpenAI (if you have API key):
#   openai/gpt-4o-mini
#   openai/gpt-4o
# Anthropic (if you have API key):
#   anthropic/claude-3-5-sonnet-20241022
DSPY_PROVIDER="openrouter/mistralai/mistral-small-3.2-24b-instruct"

# API Keys (only set what you're using)
OPENROUTER_API_KEY=sk-or-your-key-here
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Configuration (for embeddings)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma:latest

# Vision model for ImageLoader (sfl-analyze knowledge-base --images).
# Must be a vision-capable model hosted by your configured DSPY_PROVIDER.
# Examples: claude-sonnet-4-6, gpt-4o, google/gemini-1.5-pro
# Leave unset to skip image analysis (safe default — vision calls are expensive).
# VISION_MODEL=claude-sonnet-4-6

# spaCy Model for Pass 1
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=info

# Pass 2 batch tuning (smaller batches = faster first Langfuse trace)
SFL_BATCH_SIZE=4
SFL_CHUNK_TIMEOUT=90

# Provider fallback chain — tried in order when primary times out or errors.
# Comma-separated; all must share the same prefix key (openrouter/ → OPENROUTER_API_KEY).
SFL_FALLBACK_PROVIDERS=openrouter/xiaomi/mimo-v2.5,openrouter/google/gemini-2.5-flash-lite,openrouter/deepseek/deepseek-v4-flash,openrouter/qwen/qwen3-30b-a3b-thinking-2507,openrouter/nvidia/nemotron-nano-9b-v2:free,openrouter/z-ai/glm-4.7-flash,openrouter/qwen/qwen3-235b-a22b-thinking-2507

# Generation parameters — applied uniformly to every provider in the chain.
# Unset or empty = provider default.
SFL_TEMPERATURE=
SFL_TOP_P=
SFL_TOP_K=

# Gush (parallel job workflows) — Redis connection for workflow/job state
REDIS_URL=redis://localhost:6379

# Observability (optional — tracing to Langfuse via OpenTelemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
